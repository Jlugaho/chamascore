# ChamaScore Environment Variables
# Copy to .env and fill in your values

APP_ENV=development
POSTGRES_PASSWORD=replace-with-a-local-url-safe-password
AIRFLOW_DB_PASSWORD=replace-with-another-local-url-safe-password
AIRFLOW_ADMIN_PASSWORD=replace-with-a-local-airflow-admin-password
AIRFLOW_WEB_SECRET_KEY=replace-with-a-stable-random-airflow-secret
DATABASE_URL=postgresql+psycopg2://chamascore:${POSTGRES_PASSWORD}@localhost:5432/chamascore
CHAMASCORE_DB_URL=postgresql+psycopg2://chamascore:${POSTGRES_PASSWORD}@postgres:5432/chamascore
SECRET_KEY=your-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
REACT_APP_API_URL=http://127.0.0.1:8000